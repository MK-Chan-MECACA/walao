# Postgres connection (ticket 1 uses a real Postgres for the whole-system test seam)
DATABASE_URL=postgres://localhost:5432/walao

# Shared secret the gateway signs webhooks with (HMAC-SHA256, hex, over the raw body)
WALAO_WEBHOOK_SECRET=dev-webhook-secret-change-me

# 32-byte AES-256-GCM key for message-body encryption at rest, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALAO_ENC_KEY=

# Reject webhook events whose sent_at is outside this many seconds from now
WALAO_FRESHNESS_SECONDS=300

# HTTP port for the API/webhook server
PORT=3000
