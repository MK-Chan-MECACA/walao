# Postgres connection (ticket 1 uses a real Postgres for the whole-system test seam)
DATABASE_URL=postgres://localhost:5432/walao

# Shared secret the gateway signs webhooks with (HMAC-SHA256, hex, over the raw body)
WALAO_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Operator-only secret authorizing /admin (halt switch, quality review queue)
WALAO_OPERATOR_SECRET=dev-operator-secret-change-me

# 32-byte AES-256-GCM key for message-body encryption at rest, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALAO_ENC_KEY=

# Reject webhook events whose sent_at is outside this many seconds from now
WALAO_FRESHNESS_SECONDS=300

# HTTP port for the API/webhook server
PORT=3000

# WAAPI Gateway (github.com/mecaca-global-inc/waapi-gateway) — the WhatsApp
# bridge. Optional: WALAO boots without it, but pairing and outbound delivery
# fail until an API key is set. Get one from the gateway dashboard, or
# POST /api/login then POST /api/keys.
WAAPI_BASE_URL=http://localhost:8080
WAAPI_API_KEY=

# Anthropic API key for the summarizer. Optional: without it the server falls
# back to a local echo stand-in that repeats messages verbatim instead of
# condensing them — fine for wiring up the pipeline, not for real briefs.
ANTHROPIC_API_KEY=

# Model the summarizer calls. Defaults to claude-opus-5.
WALAO_SUMMARIZER_MODEL=

# Resend API key for login-code email. Optional: without it the code is printed
# to the server log instead of mailed, which is enough for local work but means
# no real user can sign in.
RESEND_API_KEY=

# Sender for that email. Must be an address on a domain verified in Resend.
# Defaults to WALAO <onboarding@resend.dev>, which Resend only delivers to the
# address that owns the API key — fine for a first test, not for real users.
WALAO_MAIL_FROM=
